rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net catch-all block:
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers & Global Safeguards
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Checks if user is an admin by querying the whitelisted collection or matching the bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "raksha05jk.rao@gmail.com" ||
        request.auth.token.email == "theimperialscholarupsc05@gmail.com"
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 128
        && data.photoURL is string && data.photoURL.size() <= 2000
        && data.role in ['user', 'admin']
        && (data.role == 'user' || isAdmin());
    }

    function isValidPersonalResource(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'type', 'url', 'category', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.description is string && data.description.size() <= 50000
        && data.type in ['pdf', 'link', 'video', 'other', 'photo', 'note']
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1048576
        && data.category is string && data.category.size() <= 128
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128));
    }

    function isValidResourceHubItem(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'type', 'url', 'category', 'createdAt', 'createdBy', 'createdByName'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.description is string && data.description.size() <= 50000
        && data.type in ['pdf', 'link', 'video', 'other', 'photo', 'note']
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1048576
        && data.category is string && data.category.size() <= 128
        && data.createdBy == request.auth.uid
        && data.createdByName is string && data.createdByName.size() <= 128
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128));
    }

    function isValidSavedStuffItem(data) {
      return data.keys().hasAll(['id', 'originalId', 'title', 'description', 'type', 'url', 'category', 'origin', 'savedAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 256
        && data.description is string && data.description.size() <= 50000
        && data.type in ['pdf', 'link', 'video', 'other', 'photo', 'note']
        && data.url is string && data.url.size() > 0 && data.url.size() <= 1048576
        && data.category is string && data.category.size() <= 128
        && data.origin in ['personal', 'hub']
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128));
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['id', 'name', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128;
    }

    // 4. Matches and Collection Guarding

    // Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().role == existing().role;
      allow delete: if false;
    }

    // Personal Private Vault Subcollection (Insulated per-user)
    match /users/{userId}/personal_resources/{resourceId} {
      allow read, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(resourceId) && isValidPersonalResource(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(resourceId) && isValidPersonalResource(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Folders Subcollection
    match /users/{userId}/folders/{folderId} {
      allow read, list: if isSignedIn() && isOwner(userId);
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(folderId) && isValidFolder(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Saved Stuff Subcollection
    match /users/{userId}/saved_stuff/{savedId} {
      allow read, list: if isSignedIn() && isOwner(userId);
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(savedId) && isValidSavedStuffItem(incoming());
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Resource Hub Collection (Curated Content - Read/accessible by ALL signed-in candidates & users)
    match /resource_hub/{resourceId} {
      allow read, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(resourceId) && isValidResourceHubItem(incoming());
      allow update: if isAdmin() && isValidId(resourceId) && isValidResourceHubItem(incoming())
        && incoming().createdBy == existing().createdBy;
      allow delete: if isAdmin();
    }

    // Shared Files & Attachments uploaded to Resource Hub (All users can read/download)
    match /shared_files/{fileId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    // Whitelisted Core Admins List
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
